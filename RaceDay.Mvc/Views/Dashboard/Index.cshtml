@model UserProfileResponse
@{
    ViewData["Title"] = "Dashboard";
    var isOrganiser = Model.Role == "ORGANISER";
}
<section class="dashboard-hero">
    <p class="eyebrow">@(isOrganiser ? "Organiser workspace" : "Your RaceDay")</p>
    <h1>@(isOrganiser ? $"Welcome, {Model.FirstName}." : $"Ready for your next race, {Model.FirstName}?")</h1>
    <p>@(isOrganiser
        ? "Manage the events you organise, review participant entries and record race results."
        : "Your participant account is ready. Profile details are available here; event and results pages will follow.")</p>
    @if (isOrganiser)
    {
        <a class="button button-primary" asp-controller="Organiser" asp-action="Index">Open organiser workspace</a>
    }
    else
    {
        <a class="button button-primary" asp-controller="Profile" asp-action="Index">View my profile</a>
    }
</section>
<section class="dashboard-card">
    <div><span class="card-kicker">Signed in as</span><h2>@Model.FirstName @Model.LastName</h2><p>@Model.Email</p></div>
    <span class="role-pill">@Model.Role</span>
</section>
