@model OrganiserResultsViewModel
@{ ViewData["Title"] = "Results"; }
<section class="content-heading"><p class="eyebrow">@Model.Event.EventName</p><h1>Race results</h1><p>Record and correct finish times and finishing positions.</p></section>
<p><a asp-controller="Organiser" asp-action="EventDetails" asp-route-id="@Model.Event.EventID">← Event details</a></p>
@if (Model.Results.Count == 0) { <div class="empty-state"><h2>No participants yet</h2><p>Results can be recorded after enrolments are available.</p></div> }
else { <div class="table-wrap"><table><thead><tr><th>Participant</th><th>Category</th><th>Status</th><th>Finish time</th><th>Position</th><th>Actions</th></tr></thead><tbody>@foreach (var row in Model.Results) { <tr><td>Participant #@row.Enrolment.ParticipantID</td><td>@row.CategoryName</td><td>@row.Enrolment.Status</td><td>@(row.Result is null ? "Not recorded" : $"{(long)row.Result.FinishTime.TotalHours:00}:{row.Result.FinishTime.Minutes:00}:{row.Result.FinishTime.Seconds:00}")</td><td>@(row.Result?.FinishingPosition.ToString() ?? "—")</td><td><a asp-action="EditResult" asp-route-eventId="@Model.Event.EventID" asp-route-enrolmentId="@row.Enrolment.EnrolmentID">@(row.Result is null ? "Record" : "Edit")</a>@if (row.Result is not null) { <form class="inline-form" asp-action="DeleteResult" asp-route-eventId="@Model.Event.EventID" asp-route-enrolmentId="@row.Enrolment.EnrolmentID" method="post"><button class="text-button" type="submit">Remove</button></form> }</td></tr> }</tbody></table></div> }
