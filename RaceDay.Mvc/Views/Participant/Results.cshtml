@model ParticipantResultsViewModel
@{ ViewData["Title"] = "My results"; }
<section class="page-heading"><p class="eyebrow">Participant · My races</p><h1>My results</h1><p>Race results recorded for your enrolments.</p></section>
@if(Model.Results.Count == 0){<p class="empty-state">You do not have any recorded results yet.</p>}
else{<div class="table-wrap"><table><thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Finish time</th><th>Position</th></tr></thead><tbody>@foreach(var result in Model.Results){<tr><td>@result.EventName</td><td>@result.EventDate.ToString("d")</td><td>@result.CategoryName</td><td>@result.FinishTime</td><td>@result.FinishingPosition</td></tr>}</tbody></table></div>}
